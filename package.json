{
  "name": "dsh-token-heatmap",
  "version": "0.5.0",
  "private": true,
  "description": "Daily token heatmap in DSH settings, from local logs. ｜ DSH 设置里的每日 token 用量热力图，取自本机会话日志。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "heatmap",
    "cost"
  ],
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "scripts": {
    "check": "node --check client.js && node --check lib/index.js && node --check lib/pricing.js && prettier --check .",
    "format": "prettier --write .",
    "test": "node tools/test-client.mjs && node tools/test-weekly.mjs && node tools/test-host.mjs && node tools/test-apply.mjs",
    "test:logs": "node tools/test-plugin.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
